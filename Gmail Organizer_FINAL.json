    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let assignedLabel = \"\";\nlet originalLabelItems = [];\nlet newlyCreatedLabels = [];\n\ntry {\n  assignedLabel = String(\n    $('Labeling logic').item.json.assignedLabel || \n    $json.assignedLabel || \n    \"\"\n  ).trim();\n\n  originalLabelItems = $('Get many labels').all();\n\n  // We use try/catch here because if 'Create a label' hasn't run yet, it throws a safe error.\n  try {\n      newlyCreatedLabels = $('Create a label').all();\n  } catch(e) {\n      newlyCreatedLabels = []; \n  }\n\n} catch (err) {\n  return { json: { debugError: err.message } };\n}\n\nconst searchLabel = assignedLabel.toLowerCase();\n\n//FIRST CHECK: Did we just create this in a previous loop iteration?\nconst newlyCreatedObj = newlyCreatedLabels.find(\n   item => String(item.json.name || \"\").trim().toLowerCase() === searchLabel\n);\n\nif (newlyCreatedObj) {\n   // We already created it! Route to the TRUE branch to skip creation.\n   return {\n     json: {\n       ...$json,\n       assignedLabel: assignedLabel,\n       labelExists: true, \n       existingLabelId: newlyCreatedObj.json.id, // Grab the newly created ID\n       hasAttachments: $binary !== undefined && Object.keys($binary).length > 0\n     }\n   };\n}\n\n//SECOND CHECK: Is it in the original Google list?\nconst existingLabelObj = originalLabelItems.find(\n  item => String(item.json.name || \"\").trim().toLowerCase() === searchLabel\n);\n\nconst labelExists = !!existingLabelObj;\nconst existingLabelId = existingLabelObj ? existingLabelObj.json.id : null;\n\nreturn {\n  json: {\n    ...$json,\n    assignedLabel: assignedLabel,\n    labelExists: labelExists,\n    existingLabelId: existingLabelId,\n    hasAttachments: $binary !== undefined && Object.keys($binary).length > 0\n  }\n};"
      },
