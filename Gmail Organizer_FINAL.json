    {
      "parameters": {
        "jsCode": "// Existing processed messages from Logs sheet\nconst logItems = $items(\"Logs check\");\n\n// Classification rules from Google Sheets\nconst rulesItems = $items(\"Classification rules\");\n\n// Emails retrieved from Gmail\nconst emailItems = $items(\"Get emails\");\n\n// Message IDs already recorded in Logs\nconst existingMessageIds = new Set(\n  logItems\n    .map(item => String(item.json[\"Message ID\"] || \"\").trim())\n    .filter(Boolean)\n);\n\n// ==========================================\n// PREPARE ACTIVE CLASSIFICATION RULES\n// ==========================================\n\nconst activeRules = rulesItems\n  .map(item => item.json)\n  .filter(rule =>\n    rule.Active === true ||\n    String(rule.Active).toLowerCase() === \"true\"\n  )\n  .filter(rule =>\n    rule.Label &&\n    rule.Keywords\n  )\n  .sort((a, b) =>\n    Number(b.Priority || 0) - Number(a.Priority || 0)\n  );\n\n// TRACK DUPLICATES IN CURRENT BATCH\nconst seenSignatures = new Set();\n// PROCESS EMAILS\nfor (const item of emailItems) {\n\n  const data = item.json;\n\n\n  // ========================================\n  // MESSAGE ID\n  // ========================================\n\n  const messageId = String(\n    data.id ||\n    data.messageId ||\n    \"\"\n  ).trim();\n\n  item.json.messageIdToLog = messageId;\n\n  // SUBJECT\n\n  const subject = String(\n    data.subject ||\n    data.Subject ||\n    \"\"\n  );\n  \n  // BODY\n  \n  const body = String(\n    data.text ||\n    data.textPlain ||\n    data.body ||\n    \"\"\n  );\n\n  // SENDER\n  \n  let senderEmail = \"\";\n\n  if (\n    data.from &&\n    data.from.value &&\n    data.from.value.length > 0\n  ) {\n    senderEmail =\n      data.from.value[0].address ||\n      \"\";\n  }\n\n  // Fallback for other possible Gmail formats\n  if (!senderEmail && data.from?.email) {\n    senderEmail = data.from.email;\n  }\n\n  senderEmail = String(senderEmail)\n    .trim()\n    .toLowerCase();\n\n  // NORMALIZE CONTENT\n\n  const normalizedSubject = subject\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .toLowerCase();\n\n  const normalizedBody = body\n    .replace(/https?:\\/\\/\\S+/gi, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .toLowerCase();\n\n  // CONTENT SIGNATURE\n\n  /*\n   * Two messages are considered content-duplicates when\n   * they come from the same sender and have the same\n   * normalized subject and body.\n   */\n\n  const signature =\n    `${senderEmail}||${normalizedSubject}||${normalizedBody}`;\n\n  // 1. Has this exact Gmail message already been logged?\n  const alreadyLogged =\n    messageId &&\n    existingMessageIds.has(messageId);\n\n  //    appeared in this current Gmail batch?\n  const duplicateContent =\n    seenSignatures.has(signature);\n\n  item.json.isDuplicate =\n    alreadyLogged ||\n    duplicateContent;\n\n  seenSignatures.add(signature);\n\n\n  // ========================================\n  // CLASSIFICATION\n  // ========================================\n\n  const emailContent =\n    `${normalizedSubject} ${normalizedBody}`;\n\n  let assignedLabel = \"misc\";\n\n\n  for (const rule of activeRules) {\n\n    const keywords = String(rule.Keywords)\n      .split(\",\")\n      .map(keyword =>\n        keyword.trim().toLowerCase()\n      )\n      .filter(Boolean);\n\n\n    const matched = keywords.some(keyword =>\n      emailContent.includes(keyword)\n    );\n\n\n    if (matched) {\n      assignedLabel = rule.Label;\n      break;\n    }\n  }\n\n  // SAVE RESULT\n  item.json.assignedLabel = assignedLabel;\n}\n\nreturn emailItems;\n\n"
      },
